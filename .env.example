# Safe defaults. A private key alone NEVER enables live mode.
MODE=paper
DRY_RUN=true
MODEL=mock
RPC_URL=https://rpc.monad.xyz
READ_RPC_URL=https://rpc.monad.xyz
WS_URL=wss://rpc.monad.xyz

# Direct TypeSafe API. Model is pinned; changing it changes strategy identity.
TYPESAFE_API_KEY=
JEV_MODEL_ID=jev-1.14.0
JEV_USD_PER_MILLION_INPUT_TOKENS=0.042
DETERMINISTIC_FALLBACK=true

# Engineering examples, not a recommended investment allocation.
BANKROLL_USD=10000
TRADE_SIZE_MON=800
MAX_POSITION_MON=2000
MARGIN_MON=1000
MARGIN_USDC=20
MAX_DAILY_LOSS_USD=200
MAX_DRAWDOWN_FRACTION=0.05
MAX_INVENTORY_AGE_MS=3600000
MAX_LEVERAGE=1
MAX_API_ERRORS=5
MAX_DATA_AGE_MS=900
BLOCK_MS=300
DECISION_DEADLINE_MS=250
RPC_TIMEOUT_MS=3000
MIN_VOL_SAMPLES=20

AS_GAMMA=0.1
AS_KAPPA=1000000
AS_HORIZON_SECONDS=30
MIN_SPREAD_BPS=10
MIN_QUOTE_LIFE_MS=5000
MAX_QUOTE_LIFE_MS=30000
REPRICE_BPS=5
# Assumptions are logged and must be calibrated to a venue. No measured edge is implied.
EXPECTED_FILL_PROBABILITY=0.1
MAKER_FEE_BPS=0
SLIPPAGE_BPS=1
ADVERSE_SELECTION_BPS=1
MAX_GAS_USD_PER_HOUR=1
MIN_NET_EDGE_USD=0
GAS_LIMIT=650000
MAX_FEE_GWEI=400
PRIORITY_FEE_GWEI=2

HOST=127.0.0.1
PORT=3000
DATA_DIR=data
# Required only for POST /control/kill and GET /audit; not needed for read-only dashboard.
CONTROL_TOKEN=

# Live transport configuration. No automatic deposits, token approvals or key creation.
PRIVATE_KEY=
LIVE_TRADING_ENABLED=false
LIVE_AUTHORIZATION_FILE=
RECONCILE_FROM_BLOCK=0
MAX_RECONCILE_BLOCKS=10000
